 *
 * A split pair over BabbleSim. The halves link and sync; the central steps its
 * LED pattern once, and the peripheral steps it back with a key of its own,
 * which the central runs and mirrors. (A reset is not part of it: a simulated
 * device that reboots exits, and the simulation ends with it.)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/led_pattern.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

#include "shared.dtsi"

/* Step the pattern on the central well after the pair has synced. */
&kscan {
    /delete-property/ exit-after;
    events = <ZMK_MOCK_PRESS(0,0,8000) ZMK_MOCK_RELEASE(0,0,200)>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &led_pattern LED_PATTERN_NEXT &led_pattern LED_PATTERN_PREVIOUS
            &kp C &kp D>;
        };
    };
};
