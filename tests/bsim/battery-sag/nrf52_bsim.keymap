 *
 * The battery path over BabbleSim. Both halves sample their battery every
 * second through the LED wrapper while the central holds the LED steady and
 * then steps it through 0, 50 and 100 percent; the peripheral follows by
 * mirror. The stand-in divider logs what it reads uncorrected, which moves
 * with the LED; the levels ZMK reports - each half's own and the
 * peripheral's as the central reads it over BLE - must not.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/led_pattern.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

#include "shared.dtsi"

&kscan {
    /delete-property/ exit-after;
    events = <ZMK_MOCK_PRESS(0,0,5000) ZMK_MOCK_RELEASE(0,0,3000)
              ZMK_MOCK_PRESS(0,1,100) ZMK_MOCK_RELEASE(0,1,3000)
              ZMK_MOCK_PRESS(1,0,100) ZMK_MOCK_RELEASE(1,0,3000)
              ZMK_MOCK_PRESS(1,1,100) ZMK_MOCK_RELEASE(1,1,3000)>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &led_pattern LED_PATTERN_STEADY &led_brightness 0
            &led_brightness 50              &led_brightness 100>;
        };
    };
};
